#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>

int main()
{
    int fd[2],n;
    char msg[]="Hello from Parent Process",buf[100];

    pipe(fd);
    if(fork()==0)
    {
        close(fd[1]);
        n=read(fd[0],buf,99);
        buf[n]='\0';
        printf("Child received: %s\n",buf);
        close(fd[0]);
    }
    else
    {
        close(fd[0]);
        printf("Parent sending :%s\n",msg);
        write(fd[1],msg,strlen(msg)+1);
        close(fd[1]);
        wait(NULL);
    }
    return 0;
}
