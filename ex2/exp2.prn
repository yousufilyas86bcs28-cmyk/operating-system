[24bcs051@mepcolinux ex2]$cat 2ndmax.c
#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
#include<limits.h>

int main()
{
 int p[2],q[2],a[100],o[100],n,c,i;
 pipe(p);pipe(q);

 if(!fork())
 {
  close(p[0]);
  scanf("%d",&n);
  for(i=0;i<n;i++)scanf("%d",&a[i]);
  write(p[1],&n,4);write(p[1],a,n*4);
  return 0;
 }
 wait(0);

 if(!fork())
 {
  close(p[1]);close(q[0]);
  read(p[0],&n,4);read(p[0],a,n*4);
  c=0;
  for(i=0;i<n;i++)if(a[i]%2)o[c++]=a[i];
  write(q[1],&c,4);write(q[1],o,c*4);
  return 0;
 }
 wait(0);

 if(!fork())
 {
  int x=INT_MIN,y=INT_MIN;
  close(q[1]);
  read(q[0],&c,4);read(q[0],o,c*4);
  for(i=0;i<c;i++)
   if(o[i]>x)y=x,x=o[i];
   else if(o[i]>y&&o[i]!=x)y=o[i];
  if(c<2||y==INT_MIN)printf("Second Maximum not found");
  else printf("Second Maximum = %d",y);
  return 0;
 }
 wait(0);
}
