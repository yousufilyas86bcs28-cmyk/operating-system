[24bcs051@mepcolinux ex2]$cat lcm.c
#include <stdio.h>
#include <unistd.h>

int main()
{
    int fd[2],n[2],a,b,t,g;
    pipe(fd);

    if(fork())
    {
        close(fd[0]);
        printf("P1 - Enter two numbers: ");
        scanf("%d%d",&n[0],&n[1]);
        write(fd[1],n,sizeof(n));
        close(fd[1]);
    }
    else
    {
        close(fd[1]);
        read(fd[0],n,sizeof(n));
        close(fd[0]);

        a=n[0]; b=n[1];

        int x=a,y=b;
        while(y)
        {
            t=y;
            y=x%y;
            x=t;
        }
        g=x;

        printf("LCM = %d\n",(a*b)/g);
    }
    return 0;
}
