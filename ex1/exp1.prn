#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>

int main() {
    pid_t p1, p3;
    char str[100];
    int i;

    printf("P1 Enter a String: ");
    scanf("%s",str);
    p1 = fork();
    if (p1==-1) {
        printf("Fork failed");
        return 1;
    }

    if (p1 == 0) {

        int vowels = 0;
        for (i = 0; str[i] != '\0'; i++) {
            char ch = tolower((char)str[i]);
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                vowels++;
            }
        }
        printf("No of Vowels: %d\n", vowels);
    }
    else {
        p3 = fork();

        if (p3 == -1) {
            printf("Fork failed");
            return 1;
        }

        if (p3 == 0) {

            int special = 0;
            for (i = 0; str[i] != '\0'; i++) {
                if (!isalnum((char)str[i]) && !isspace((char)str[i])) {
                    special++;
                }
            }
            printf("No of special Characters: %d\n", special);
        }
        else {
            wait(NULL);
            wait(NULL);
        }
    }
    return 0;
}
